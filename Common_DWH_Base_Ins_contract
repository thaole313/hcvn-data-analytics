CREATE TABLE TH_INSURANCE AS
SELECT 
t1.SKP_CLIENT,
t5.TEXT_CONTRACT_NUMBER,
t1.SKP_CREDIT_CASE,
TRUNC(t5.DTIME_SIGNATURE_CONTRACT) AS DATE_SIGN,
t3.CODE_PRODUCT,
t1.AMT_PREMIUM,
t1.AMT_SUM_INSURED,
t4.CODE_INSURANCE_STATUS,
t6.CODE_SERVICE,
 CASE 
        WHEN t6.CODE_SERVICE LIKE 'HOCO_%'
          OR t6.CODE_SERVICE LIKE '%_HOCO'
            THEN 'HOCO'
        WHEN t6.CODE_SERVICE LIKE 'CI_%'
          OR t6.CODE_SERVICE LIKE '%_CI'
            THEN 'CI'
        WHEN t6.CODE_SERVICE IN ('GI_BM_1', 'GI_TWCB12', 'GI_TWCB24', 'TW_GD_AAA','GI_TWCB12_EBIKE2','GI_TWCB12_GBIKE2')
            THEN 'TWI'

        WHEN t6.CODE_SERVICE LIKE 'ADLD%'
            THEN 'ADLD'
        WHEN t6.CODE_SERVICE LIKE 'LI%'
            THEN 'PPI'
        WHEN t6.CODE_SERVICE LIKE 'ICL%' THEN 'ICL'
        WHEN t6.CODE_SERVICE LIKE 'ADLD%'
            THEN 'ADLD'
        WHEN t6.CODE_SERVICE LIKE 'PPI_MIC_CC%' THEN 'SP'

        ELSE 'Others'  END AS INSURANCE_TYPE,
        
row_number() over (partition by t1.skp_credit_case, t6.code_service order by t1.dtime_start desc) as row_num   
FROM OWNER_DWH.F_INSURANCE_AT t1 
LEFT JOIN OWNER_DWH.dc_insurance t6 on t1.skp_insurance = t6.skp_insurance
--LEFT JOIN OWNER_DWH.DC_CLIENT t2 ON t1.SKP_CLIENT = t2.SKP_CLIENT
LEFT JOIN OWNER_DWH.CL_INSURANCE_STATUS t4 ON t1.skp_insurance_status = t4.skp_insurance_status
LEFT JOIN OWNER_DWH.F_CONTRACT_BASE_AD t5 ON t6.SKP_CREDIT_CASE = t5.SKP_CREDIT_CASE
LEFT JOIN OWNER_DWH.dc_product t3 ON t5.skp_product = t3.skp_product

WHERE 
TRUNC(t5.DTIME_SIGNATURE_CONTRACT)>= '01-JAN-23' AND TRUNC(t5.DTIME_SIGNATURE_CONTRACT) <> '01-JAN-3000'
AND t6.CODE_SERVICE <> 'XNA';

CREATE TABLE INSURANCE_ALL AS

SELECT 
    SKP_CREDIT_CASE,
    'PPI' AS INSURANCE_TYPE,
    COUNT(*) AS CNT_INSURANCE
FROM ap_crm.tmp_tb_final_adhoc_ppi_et_2225
WHERE (DATE_SIGN >= DATE '2023-01-01'
  AND DATE_SIGN <= DATE '2025-12-31') AND F_SAPPI = 1
GROUP BY 
    SKP_CREDIT_CASE
UNION ALL 

SELECT 
    SKP_CREDIT_CASE,
    'PPI' AS INSURANCE_TYPE,
    COUNT(*) AS CNT_INSURANCE
FROM TH_INSURANCE
WHERE ROW_NUM = 1
  AND INSURANCE_TYPE = 'PPI'
  AND DATE_SIGN >= DATE '2023-01-01'
  AND CODE_INSURANCE_STATUS NOT IN ('C')
GROUP BY 
    SKP_CREDIT_CASE

UNION ALL 

SELECT 
    SKP_CREDIT_CASE,
    'HOCO' AS INSURANCE_TYPE,
    COUNT(*) AS CNT_INSURANCE
FROM TH_INSURANCE
WHERE ROW_NUM = 1
  AND INSURANCE_TYPE = 'HOCO'
  AND DATE_SIGN >= DATE '2023-01-01'
  AND CODE_INSURANCE_STATUS NOT IN ('C')
GROUP BY 
    SKP_CREDIT_CASE

UNION ALL 

SELECT 
    SKP_CREDIT_CASE,
    'CI' AS INSURANCE_TYPE,
    COUNT(*) AS CNT_INSURANCE
FROM TH_INSURANCE
WHERE ROW_NUM = 1
  AND INSURANCE_TYPE = 'CI'
  AND DATE_SIGN >= DATE '2023-01-01'
  AND CODE_INSURANCE_STATUS NOT IN ('C')
GROUP BY 
    SKP_CREDIT_CASE

UNION ALL 

SELECT 
    SKP_CREDIT_CASE,
    'TWI' AS INSURANCE_TYPE,
    COUNT(*) AS CNT_INSURANCE
FROM TH_INSURANCE

WHERE ROW_NUM = 1
  AND INSURANCE_TYPE = 'TWI'
  AND DATE_SIGN >= DATE '2023-01-01'

  AND CODE_INSURANCE_STATUS NOT IN ('C')
GROUP BY 
    SKP_CREDIT_CASE

UNION ALL 

SELECT 
    SKP_CREDIT_CASE,
    'ADLD' AS INSURANCE_TYPE,
    COUNT(*) AS CNT_INSURANCE
FROM TH_INSURANCE

WHERE ROW_NUM = 1
  AND INSURANCE_TYPE = 'ADLD'
  AND DATE_SIGN >= DATE '2023-01-01'
  AND CODE_INSURANCE_STATUS NOT IN ('C')
GROUP BY 
    SKP_CREDIT_CASE;
