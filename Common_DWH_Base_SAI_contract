

CREATE TABLE REPEATED_DATA AS
SELECT
TEXT_INSURED_ID_NUMBER AS RP_ID_NUMBER, 
REPLACE(TRIM(UPPER(TEXT_INSURED_NAME)),'_','') AS RP_NAME_INSURED,
DATE_INSURED_DDOB AS RP_DATE_INSURED_DDOB,
DATE_CREATED_AT AS RP_DATE_CREATED_AT,
DATE_UPDATED_AT AS RP_DATE_UPDATED_AT,
REPLACE(TRIM(UPPER(TEXT_INSURED_NAME)),'_','')||'-'||DATE_INSURED_DDOB AS KEY_NAME_DOB, ----key2
DATE_EXPIRY AS RP_DATE_EXPIRY ,
TEXT_POLICY_NUMBER AS RP_POLICY_NUMBER,
TEXT_QUOTATION_NUMBER AS RP_QUOTATION_NUMBER,
AMT_PREMIUM_GROSS AS RP_PREMIUM ,
TEXT_INSURED_PROVINCE AS RP_PROVINCE,
case when text_product_vn = 'Bảo hiểm sức khỏe nội trú - Home Credit' THEN 'ITP'
    WHEN text_product_vn = 'Bảo hiểm sức khỏe - Home Credit' THEN 'ITP'
    WHEN text_product_vn = 'Bảo hiểm sức khỏe toàn diện - Home Credit' THEN 'CHP'
    WHEN text_product_vn = 'Bảo hiểm tai nạn nâng cao - Home Credit' THEN 'PA'
    WHEN text_product_vn = 'Bảo hiểm tai nạn cá nhân - Home Credit' THEN 'PA'ELSE 'Others' END AS RP_PRODUCT_CODE,
TEXT_PLAN AS RP_PLAN   
FROM OWNER_EXT.EX_MSIG_CURRENT
WHERE UPPER(TEXT_CONTRACT_STATUS) IN ('ISSUED','EXPIRED') 

UNION ALL 
SELECT
ID_NUMBER AS RP_ID_NUMBER, 
REPLACE(TRIM(UPPER(NAME_INSURED)),'_','') AS RP_NAME_INSURED,
DATE_INSURED_DDOB AS RP_DATE_INSURED_DDOB,
DATE_CREATED_AT AS RP_DATE_CREATED_AT,
DATE_UPDATED_AT AS RP_DATE_UPDATED_AT,
REPLACE(TRIM(UPPER(NAME_INSURED)),'_','')||'-'||DATE_INSURED_DDOB AS KEY_NAME_DOB, ----key2
DATE_EXPIRY AS RP_DATE_EXPIRY ,
TEXT_POLICY_NUMBER AS RP_POLICY_NUMBER,
TEXT_QUOTATION_NUMBER AS RP_QUOTATION_NUMBER,
AMT_PREMIUM_GROSS AS RP_PREMIUM ,
TEXT_ADDRESS AS RP_PROVINCE,
case when text_product_vn = 'Bảo hiểm Bệnh hiểm nghèo' THEN 'CI'
ELSE 'CI' END AS RP_PRODUCT_CODE,
TEXT_BAND AS RP_PLAN   
FROM OWNER_EXT_LOCAL.EX_GIC_CURRENT
WHERE  UPPER(TEXT_CONTRACT_STATUS) IN ('ISSUED','EXPIRED')  ;
