CREATE TABLE CHANNEL_BOD01_UPDATE AS 
    SELECT 
        a.SKP_CREDIT_CASE,
         CASE
            WHEN a.SKP_SALESROOM_APPL_CREATED = 75618839 THEN 'FPT'
            WHEN a.SKP_SALESROOM_APPL_CREATED = 80259037 THEN 'NGANLUONG'
            WHEN a.SKP_SALESROOM_APPL_CREATED = 74461310 THEN 'NEXTPAY'
            WHEN a.SKP_SALESROOM_APPL_CREATED = 79166855 THEN 'FPT_LONGCHAU'
            WHEN a.SKP_SALESROOM_APPL_CREATED = 72103174 THEN 'MW'
            WHEN a.SKP_SALESROOM_APPL_CREATED = 91724244 THEN 'BE'
            WHEN a.SKP_SALESROOM_APPL_CREATED = 79526396 THEN 'VNPT'
            WHEN a.TEXT_APL_BOD01_CHANNEL = 'CLW_ONLINE' THEN 'Web'
            WHEN a.TEXT_APL_BOD01_CHANNEL = 'MOBILE_APP' THEN 'CAPP'
            WHEN a.TEXT_APL_BOD01_CHANNEL = 'OTHER' THEN 'Others'
            WHEN a.TEXT_APL_BOD01_CHANNEL IN ('TLS_ACL', 'TLS_BT') THEN 'TLS'
            WHEN a.TEXT_APL_BOD01_CHANNEL = 'GMA'
                 AND a.TEXT_APL_CONSULT_CHANNEL = 'RA'
                 AND a.SKP_CREDIT_TYPE = 2
            THEN 'HAPPY-RA'
            WHEN a.TEXT_APL_BOD01_CHANNEL = 'GMA' AND a.TEXT_APL_CONSULT_CHANNEL NOT IN ('MOBILE_APP', 'GMA') THEN
                'HAPPY-SA'
            WHEN a.TEXT_APL_BOD01_CHANNEL = 'GMA' THEN
                'HAPPY'
            WHEN s.CODE_SALESROOM = '012657' THEN
                  'TIKI' --tiki selling BNPL
            WHEN s.CODE_SALESROOM = '223201' THEN
                  'ONEPAY' ----ONEPAY selling BNPL
            WHEN s.CODE_SALESROOM = '223348' THEN
                  'BAOKIM' ----BAOKIM selling BNPL
            WHEN s.CODE_SALESROOM = '013124' THEN
                  'SAO' ----Stand Alone Onboarding selling BNPL
            WHEN S.CODE_SALESROOM = '013620' THEN
                  'DDV' ---- DI DONG VIET SELLING BNPL , added in 8-Aug-2023
            WHEN S.CODE_SALESROOM = '014425' THEN 'MOMO'  --add MOMO channel 11.06.2024
            WHEN S.CODE_SALESROOM = '014554' THEN 'SAO_EMP' --add selling HPL for EMP 25.07.2024
               
                 WHEN SG.CODE_SALESROOM_GROUP = 'ONLINE' ---ONLINE shop , applied for CD product only
                      AND a.CODE_APL_PROD LIKE 'CD%' THEN
                  'EPOS'
                 WHEN s.CODE_SALESROOM IN ('011725', '1E0263') THEN
                  'CLW_ONLINE' -- CLW ONLINE
                 ELSE
                a.TEXT_APL_BOD01_CHANNEL 
               END AS TEXT_APL_BOD01_CHANNEL

    FROM DM_CRM_REP.F_CRM_APPL a ---effective from 01-JAN-15
    LEFT   JOIN OWNER_DWH.DC_SALESROOM S
        ON     a.SKP_SALESROOM_APPL_CREATED = S.SKP_SALESROOM -- map name salesroom for EPOS
    LEFT   JOIN OWNER_DWH.CL_SALESROOM_GROUP SG
        ON     S.SKP_SALESROOM_GROUP = SG.SKP_SALESROOM_GROUP
